DISCORD_BOT_TOKEN=your-discord-bot-token

# Optional peer sync with Ally1 / Ally2 TOD bots (same HMAC secret on all bots).
# L2-ToD compose publishes host port 8083 -> container 8080.
# TOD_SYNC_NAME=L2-ToD
# TOD_SYNC_ORIGIN=l2-tod
# TOD_SYNC_SECRET=change-me-to-a-long-shared-secret
# TOD_SYNC_HOST=0.0.0.0
# TOD_SYNC_PORT=8080
#
# Extra peers on other machines/networks. Each URL must include the exact host port:
#   Ally1  8081
#   Ally2  8082
#   L2-ToD 8083
# Listing a peer here exports every raid boss TOD to that bot (same TOD_SYNC_SECRET).
# TOD_SYNC_PEERS=http://203.0.113.10:8081,http://203.0.113.11:8082
