# =================================================================
# --- Project Specific & Critical Ignores ---
# =================================================================

# Ignore the file containing secrets and environment variables.
# CRITICAL for security.
.env

# Ignore SQLite database files and their journals/write-ahead logs.
# CRITICAL for security, privacy, and repository health.
*.db
*.db-journal
*.db-shm
*.db-wal

# You can also be specific with your database name as a fallback
bot_database.db
bot_database.db-*

